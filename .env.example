# Core Downloader API Key
SAVENOW_API_KEY=your_savenow_api_key_here
DEBUG_FILE_LOGGING=false

# MariaDB / MySQL Database Persistence (Heroku compatible)
DATABASE_URL=mysql://mariadb:f7lQixFTVHL0GjH2rSqUaT2R1DkRU3YInu1yCLgJq4eoiGaDQpawQ8Xj9P9lftSE@185.203.216.245:3307/default

# Super Admin Dashboard Authentication
# Option 1: Escaped bcrypt hash (Next.js dotenv-expand strips unescaped '$', so escape as '\$')
# SUPER_ADMIN_PASSWORD_HASH="\$2b\$12\$..."
# Option 2: Direct password (immune to any dotenv expansion)
# SUPER_ADMIN_PASSWORD=your_admin_password
SUPER_ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=generate_a_random_64_char_secret_string

# Privacy & Visitor Analytics Settings
# full: store IP (visible to admin only)
# anonymize: mask last octet (e.g. 192.168.1.xxx)
# hash: SHA-256 salted hash of IP
ANALYTICS_IP_STORAGE_MODE=full

# Data Retention Threshold in Days
ANALYTICS_RETENTION_DAYS=90

# Optional Geolocation Provider API Key
IP_GEOLOCATION_PROVIDER=
IP_GEOLOCATION_API_KEY=

# Public Site URL
NEXT_PUBLIC_SITE_URL=https://anyvideodownloader.app
